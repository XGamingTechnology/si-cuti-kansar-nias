# Template only. Copy to .env.production (ignored), use unique random secrets, and chmod 600.
DEPLOYMENT_ENVIRONMENT=production
FRONTEND_NETWORK_NAME=si-cuti-prod-frontend
APP_NETWORK_ALIAS=si-cuti-production-app
IMAGE_REF=registry.example.invalid/si-cuti:replace-with-approved-immutable-tag-or-digest
MIGRATOR_IMAGE_REF=registry.example.invalid/si-cuti-migrator:replace-with-same-approved-version
POSTGRES_DB=si_cuti_production
POSTGRES_ADMIN_PASSWORD=replace-with-unique-production-bootstrap-secret
POSTGRES_APP_USER=si_cuti_prod_app
POSTGRES_APP_PASSWORD=replace-with-unique-production-app-secret
POSTGRES_MIGRATION_USER=si_cuti_prod_migration
POSTGRES_MIGRATION_PASSWORD=replace-with-unique-production-migration-secret
DATABASE_URL=postgresql://si_cuti_prod_app:replace@postgres:5432/si_cuti_production
DATABASE_MIGRATION_URL=postgresql://si_cuti_prod_migration:replace@postgres:5432/si_cuti_production
PRIVATE_STORAGE_PATH=/var/lib/si-cuti/documents
BACKUP_PATH=/var/backups/si-cuti/production
LOG_LEVEL=info
SESSION_TTL_SECONDS=28800
