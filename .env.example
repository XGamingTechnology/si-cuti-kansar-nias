# Runtime (do not reuse these example values in production)
NODE_ENV=development
LOG_LEVEL=info
DEPLOYMENT_ENVIRONMENT=staging
FRONTEND_NETWORK_NAME=si-cuti-local-frontend
APP_NETWORK_ALIAS=si-cuti-local-app
IMAGE_REF=si-cuti:local
MIGRATOR_IMAGE_REF=si-cuti-migrator:local

# Database provisioning credentials (Compose only)
POSTGRES_DB=si_cuti
POSTGRES_ADMIN_PASSWORD=replace-with-a-separate-bootstrap-password
POSTGRES_APP_USER=si_cuti_app
POSTGRES_APP_PASSWORD=replace-with-a-long-random-password
POSTGRES_MIGRATION_USER=si_cuti_migration
POSTGRES_MIGRATION_PASSWORD=replace-with-another-long-random-password

# Application database connection
DATABASE_URL=postgresql://si_cuti_app:replace-with-a-long-random-password@postgres:5432/si_cuti
DATABASE_MIGRATION_URL=postgresql://si_cuti_migration:replace-with-another-long-random-password@postgres:5432/si_cuti

# Private, persistent storage outside public web paths
PRIVATE_STORAGE_PATH=/var/lib/si-cuti/documents

# Reserved for M2; no authentication/session feature exists in M1
SESSION_TTL_SECONDS=28800

# Backup output is separate from primary data
BACKUP_PATH=/var/backups/si-cuti
