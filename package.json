{
  "name": "si-cuti-kansar-nias",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run tests/unit tests/http",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:all": "vitest run --no-file-parallelism",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/adapter-pg": "7.4.2",
    "@prisma/client": "7.4.2",
    "next": "16.1.6",
    "pdf-lib": "1.17.1",
    "pg": "8.18.0",
    "pino": "10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.34.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.0.18",
    "esbuild": "0.28.2",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.6",
    "prettier": "3.8.2",
    "prisma": "7.4.2",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
