# Template only. Copy to .env.staging (ignored); never place real employee data here.
DEPLOYMENT_ENVIRONMENT=staging
FRONTEND_NETWORK_NAME=si-cuti-staging-frontend
APP_NETWORK_ALIAS=si-cuti-staging-app
IMAGE_REF=registry.example.invalid/si-cuti:replace-with-approved-immutable-tag-or-digest
MIGRATOR_IMAGE_REF=registry.example.invalid/si-cuti-migrator:replace-with-same-approved-version
POSTGRES_DB=si_cuti_staging
POSTGRES_ADMIN_PASSWORD=replace-with-unique-staging-bootstrap-secret
POSTGRES_APP_USER=si_cuti_staging_app
POSTGRES_APP_PASSWORD=replace-with-unique-staging-app-secret
POSTGRES_MIGRATION_USER=si_cuti_staging_migration
POSTGRES_MIGRATION_PASSWORD=replace-with-unique-staging-migration-secret
DATABASE_URL=postgresql://si_cuti_staging_app:replace@postgres:5432/si_cuti_staging
DATABASE_MIGRATION_URL=postgresql://si_cuti_staging_migration:replace@postgres:5432/si_cuti_staging
PRIVATE_STORAGE_PATH=/var/lib/si-cuti/documents
BACKUP_PATH=/var/backups/si-cuti/staging
LOG_LEVEL=info
SESSION_TTL_SECONDS=28800
