generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationRole {
  ADMIN_KEPEGAWAIAN
  PEGAWAI
}

enum AuthenticationProvider {
  LOCAL
}

enum WorkingCalendarExceptionType {
  PUBLIC_HOLIDAY
  JOINT_LEAVE
  INSTITUTION_NON_WORKING
}

enum AnnualBalanceBucket {
  JOINT_LEAVE_CLAIM
  N2
  N1
  N
}

enum AnnualBalanceOperationType {
  GRANT
  RESERVE
  RELEASE
  COMMIT
  REVERSAL
  ADJUSTMENT
}

enum WorkflowRequestStatus {
  DRAFT
  SUBMITTED
  RETURNED_FOR_CORRECTION
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  IMPORTANT_REASON
  LARGE
  MATERNITY
  CLTN
}

enum LeaveDocumentType {
  SUBMISSION_PROOF
  APPROVED_FORM
  RETURN_BASIS
}

enum LeaveAuthorizedOfficialCapacity {
  DEFINITIVE
  PLT
  PLH
}

model LeaveAuthorizedOfficialAssignment {
  revision Int @default(0)
  corrections LeaveAuthorizedOfficialCorrection[]
  id              String                          @id @default(uuid()) @db.Uuid
  fullName        String                          @db.VarChar(200)
  nip             String                          @db.VarChar(32)
  capacity        LeaveAuthorizedOfficialCapacity
  effectiveFrom   DateTime                        @db.Date
  effectiveTo     DateTime?                       @db.Date
  sourceReference String?                         @db.VarChar(500)
  notes           String?                         @db.Text
  createdAt       DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                        @updatedAt @db.Timestamptz(3)

  @@index([effectiveFrom, effectiveTo])
}

model Employee {
  administrationEvents EmployeeAdministrationEvent[]
  id                  String    @id @default(uuid()) @db.Uuid
  nip                 String    @unique @db.VarChar(32)
  fullName            String    @db.VarChar(200)
  positionTitle       String    @db.VarChar(200)
  workUnit            String    @db.VarChar(200)
  isActive            Boolean   @default(true)
  directSupervisorId  String?   @db.Uuid
  employmentStartDate DateTime? @db.Date
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  directSupervisor        Employee?                @relation("EmployeeDirectSupervisor", fields: [directSupervisorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  directReports           Employee[]               @relation("EmployeeDirectSupervisor")
  user                    User?
  annualBalanceAccounts   AnnualBalanceAccount[]
  annualBalanceOperations AnnualBalanceOperation[]
  annualRolloverCommits   AnnualRolloverCommit[]
  n2QualifyingPeriods     N2QualifyingPeriod[]
  leaveRequests           LeaveRequest[]
  permissionRequests      PermissionRequest[]

  jointLeaveClaims JointLeaveClaim[]
  jointLeaveClaimDates JointLeaveClaimDate[]

  @@index([directSupervisorId])
}

model WorkingCalendarException {
  id              String                       @id @default(uuid()) @db.Uuid
  date            DateTime                     @unique @db.Date
  type            WorkingCalendarExceptionType
  name            String                       @db.VarChar(200)
  sourceReference String?                      @db.VarChar(500)
  notes           String?                      @db.Text
  createdAt       DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                     @updatedAt @db.Timestamptz(3)
}

model AnnualBalanceAccount {
  id              String              @id @default(uuid()) @db.Uuid
  employeeId      String              @db.Uuid
  entitlementYear Int
  bucket          AnnualBalanceBucket
  grantedDays     Int                 @default(0)
  reservedDays    Int                 @default(0)
  committedDays   Int                 @default(0)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([employeeId, entitlementYear, bucket])
}

model AnnualBalanceOperation {
  id                     String                     @id @default(uuid()) @db.Uuid
  employeeId             String                     @db.Uuid
  entitlementYear        Int
  bucket                 AnnualBalanceBucket
  operationType          AnnualBalanceOperationType
  days                   Int
  occurredAt             DateTime                   @db.Timestamptz(3)
  idempotencyKey         String                     @unique @db.VarChar(191)
  referenceType          String?                    @db.VarChar(100)
  referenceId            String?                    @db.VarChar(191)
  compensatesOperationId String?                    @db.Uuid
  reason                 String?                    @db.Text
  createdAt              DateTime                   @default(now()) @db.Timestamptz(3)

  employee               Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  compensatesOperation   AnnualBalanceOperation?      @relation("AnnualBalanceCompensation", fields: [compensatesOperationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  compensatingOperations AnnualBalanceOperation[]     @relation("AnnualBalanceCompensation")
  returnOperation        LeaveBalanceReturnOperation?
  jointLeaveDate JointLeaveClaimDate?

  @@index([employeeId, entitlementYear, bucket, occurredAt])
  @@index([compensatesOperationId])
}

model AnnualRolloverCommit {
  id             String   @id @default(uuid()) @db.Uuid
  employeeId     String   @db.Uuid
  targetYear     Int
  committedAt    DateTime @db.Timestamptz(3)
  idempotencyKey String   @unique @db.VarChar(191)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([employeeId, targetYear])
}

model N2QualifyingPeriod {
  id                  String   @id @default(uuid()) @db.Uuid
  employeeId          String   @db.Uuid
  firstZeroUsageYear  Int
  secondZeroUsageYear Int
  creditedYear        Int
  grantedDays         Int
  consumedAt          DateTime @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([employeeId, firstZeroUsageYear, secondZeroUsageYear])
  @@index([employeeId, creditedYear])
}

model JointLeavePolicy {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(200)
  applicableYear  Int
  quotaDays       Int
  claimOpensAt    DateTime @db.Timestamptz(3)
  claimDeadlineAt DateTime @db.Timestamptz(3)
  creditYear      Int
  isActive        Boolean  @default(true)
  sourceReference String?  @db.VarChar(500)
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  eventDates JointLeaveEvent[]
  claims JointLeaveClaim[]
  commandKey String? @unique @db.Uuid
  payloadHash String? @db.Char(64)
  createdByUserId String? @db.Uuid
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([applicableYear, name])
}

model JointLeaveEvent {
  id        String   @id @default(uuid()) @db.Uuid
  policyId  String   @db.Uuid
  eventDate DateTime @db.Date
  name      String   @db.VarChar(200)

  policy JointLeavePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  kind String @default("REGULAR") @db.VarChar(20)
  claimDates JointLeaveClaimDate[]

  @@unique([id, policyId])
  @@unique([policyId, eventDate])
  @@index([eventDate])
}

model User {
  employeeAdministrationEvents EmployeeAdministrationEvent[]
  avatar UserAvatar?
  avatarOperations AvatarOperation[]
  reportRuns ReportRun[]
  reportAuditEvents ReportAuditEvent[]
  calendarOverlayVersions CalendarOverlayVersion[]
  officialCorrections LeaveAuthorizedOfficialCorrection[]
  id         String          @id @default(uuid()) @db.Uuid
  employeeId String          @unique @db.Uuid
  role       ApplicationRole
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)

  employee                     Employee                      @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  authenticationIdentities     AuthenticationIdentity[]
  leaveRequestTransitions      LeaveRequestTransition[]
  permissionRequestTransitions PermissionRequestTransition[]
  uploadedLeaveDocuments       LeaveDocument[]               @relation("LeaveDocumentUploader")
  leaveBalanceReturns          LeaveBalanceReturn[]
  decisionEditions             LeaveDecisionEdition[]
  jointLeavePolicies JointLeavePolicy[]
  submittedJointLeaveClaims JointLeaveClaim[] @relation("JointLeaveSubmitter")
  reviewedJointLeaveClaims JointLeaveClaim[] @relation("JointLeaveReviewer")
}

model LeaveRequest {
  id                    String                @id @default(uuid()) @db.Uuid
  employeeId            String                @db.Uuid
  status                WorkflowRequestStatus @default(DRAFT)
  currentRevisionNumber Int                   @default(1)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)

  employee         Employee                 @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions        LeaveRequestRevision[]
  transitions      LeaveRequestTransition[]
  documents        LeaveDocument[]
  decisionArchives LeaveDecisionArchive[]
  balanceReturns   LeaveBalanceReturn[]

  @@index([employeeId, status])
  @@index([employeeId, createdAt])
}

model LeaveRequestRevision {
  id                               String    @id @default(uuid()) @db.Uuid
  leaveRequestId                   String    @db.Uuid
  revisionNumber                   Int
  leaveType                        LeaveType
  startDate                        DateTime  @db.Date
  endDate                          DateTime  @db.Date
  reason                           String    @db.Text
  formPlace                        String?   @db.VarChar(100)
  leaveAddress                     String?   @db.Text
  leavePhone                       String?   @db.VarChar(32)
  calculatedWorkingDays            Int?
  submittedAt                      DateTime? @db.Timestamptz(3)
  directSupervisorSnapshotCaptured Boolean   @default(false)
  directSupervisorIdSnapshot       String?   @db.Uuid
  directSupervisorNipSnapshot      String?   @db.VarChar(32)
  directSupervisorNameSnapshot     String?   @db.VarChar(200)
  directSupervisorTitleSnapshot    String?   @db.VarChar(200)
  createdAt                        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                        DateTime  @updatedAt @db.Timestamptz(3)

  leaveRequest     LeaveRequest             @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transitions      LeaveRequestTransition[]
  documents        LeaveDocument[]
  decisionArchives LeaveDecisionArchive[]
  balanceReturns   LeaveBalanceReturn[]

  @@unique([leaveRequestId, revisionNumber])
  @@unique([id, leaveRequestId])
}

model LeaveDocument {
  id               String            @id @default(uuid()) @db.Uuid
  leaveRequestId   String            @db.Uuid
  revisionId       String            @db.Uuid
  documentType     LeaveDocumentType
  version          Int               @default(1)
  storageKey       String            @unique @db.VarChar(191)
  checksumSha256   String            @db.Char(64)
  sizeBytes        Int
  mimeType         String            @default("application/pdf") @db.VarChar(100)
  originalFileName String?           @db.VarChar(255)
  uploadedByUserId String?           @db.Uuid
  uploadedAt       DateTime?         @db.Timestamptz(3)
  sourceIp         String?           @db.VarChar(64)
  snapshot         Json
  generatedAt      DateTime          @default(now()) @db.Timestamptz(3)

  leaveRequest LeaveRequest         @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision     LeaveRequestRevision @relation(fields: [revisionId, leaveRequestId], references: [id, leaveRequestId], onDelete: Restrict, onUpdate: Restrict)
  uploader     User?                @relation("LeaveDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  decisionArchives LeaveDecisionArchive[]
  balanceReturns   LeaveBalanceReturn[]

  @@unique([id, revisionId, leaveRequestId])
  @@unique([revisionId, documentType, version])
  @@index([leaveRequestId, generatedAt])
  @@index([uploadedByUserId, uploadedAt])
}

model LeaveRequestTransition {
  id                String                @id @default(uuid()) @db.Uuid
  leaveRequestId    String                @db.Uuid
  revisionId        String                @db.Uuid
  fromStatus        WorkflowRequestStatus
  toStatus          WorkflowRequestStatus
  actorUserId       String                @db.Uuid
  reason            String?               @db.Text
  evidenceReference String?               @db.VarChar(191)
  occurredAt        DateTime              @db.Timestamptz(3)
  idempotencyKey    String                @unique @db.VarChar(191)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)

  leaveRequest         LeaveRequest          @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision             LeaveRequestRevision  @relation(fields: [revisionId, leaveRequestId], references: [id, leaveRequestId], onDelete: Restrict, onUpdate: Restrict)
  actor                User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  leaveDecisionArchive LeaveDecisionArchive?

  @@unique([id, revisionId, leaveRequestId])
}

model PermissionType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  revisions PermissionRequestRevision[]
}

model PermissionRequest {
  id                    String                @id @default(uuid()) @db.Uuid
  employeeId            String                @db.Uuid
  status                WorkflowRequestStatus @default(DRAFT)
  currentRevisionNumber Int                   @default(1)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)

  employee    Employee                      @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions   PermissionRequestRevision[]
  transitions PermissionRequestTransition[]

  @@index([employeeId, status])
  @@index([employeeId, createdAt])
}

model PermissionRequestRevision {
  id                  String    @id @default(uuid()) @db.Uuid
  permissionRequestId String    @db.Uuid
  revisionNumber      Int
  permissionTypeId    String    @db.Uuid
  startDate           DateTime  @db.Date
  endDate             DateTime  @db.Date
  reason              String    @db.Text
  submittedAt         DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  permissionRequest PermissionRequest             @relation(fields: [permissionRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissionType    PermissionType                @relation(fields: [permissionTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transitions       PermissionRequestTransition[]

  @@unique([permissionRequestId, revisionNumber])
  @@unique([id, permissionRequestId])
  @@index([permissionTypeId])
}

model PermissionRequestTransition {
  id                  String                @id @default(uuid()) @db.Uuid
  permissionRequestId String                @db.Uuid
  revisionId          String                @db.Uuid
  fromStatus          WorkflowRequestStatus
  toStatus            WorkflowRequestStatus
  actorUserId         String                @db.Uuid
  reason              String?               @db.Text
  evidenceReference   String?               @db.VarChar(191)
  occurredAt          DateTime              @db.Timestamptz(3)
  idempotencyKey      String                @unique @db.VarChar(191)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)

  permissionRequest PermissionRequest         @relation(fields: [permissionRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision          PermissionRequestRevision @relation(fields: [revisionId, permissionRequestId], references: [id, permissionRequestId], onDelete: Restrict, onUpdate: Restrict)
  actor             User                      @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model AuthenticationIdentity {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @db.Uuid
  provider        AuthenticationProvider
  providerSubject String                 @db.VarChar(191)
  isActive        Boolean                @default(true)
  lastLoginAt     DateTime?              @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  localCredential LocalCredential?
  sessions        Session[]

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
}

model LocalCredential {
  authenticationIdentityId String   @id @db.Uuid
  passwordHash             String   @db.Text
  passwordChangedAt        DateTime @default(now()) @db.Timestamptz(3)
  createdAt                DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @db.Timestamptz(3)

  authenticationIdentity AuthenticationIdentity @relation(fields: [authenticationIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model Session {
  id                       String    @id @default(uuid()) @db.Uuid
  authenticationIdentityId String    @db.Uuid
  tokenHash                String    @unique @db.Char(64)
  expiresAt                DateTime  @db.Timestamptz(3)
  revokedAt                DateTime? @db.Timestamptz(3)
  lastSeenAt               DateTime? @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)

  authenticationIdentity AuthenticationIdentity @relation(fields: [authenticationIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([authenticationIdentityId, revokedAt])
  @@index([expiresAt])
}

model LeaveDecisionArchive {
  id               String                 @id @default(uuid()) @db.Uuid
  leaveRequestId   String                 @db.Uuid
  revisionId       String                 @db.Uuid
  transitionId     String                 @unique @db.Uuid
  sourceDocumentId String?                @db.Uuid
  snapshot         Json
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  leaveRequest     LeaveRequest           @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision         LeaveRequestRevision   @relation(fields: [revisionId, leaveRequestId], references: [id, leaveRequestId], onDelete: Restrict, onUpdate: Restrict)
  transition       LeaveRequestTransition @relation(fields: [transitionId, revisionId, leaveRequestId], references: [id, revisionId, leaveRequestId], onDelete: Restrict, onUpdate: Restrict)
  sourceDocument   LeaveDocument?         @relation(fields: [sourceDocumentId, revisionId, leaveRequestId], references: [id, revisionId, leaveRequestId], onDelete: Restrict, onUpdate: Restrict)
  artifact         LeaveDecisionArtifact?
  editions         LeaveDecisionEdition[]

  @@unique([transitionId, revisionId, leaveRequestId])
  @@index([leaveRequestId])
}

model LeaveDecisionArtifact {
  id             String               @id @default(uuid()) @db.Uuid
  archiveId      String               @unique @db.Uuid
  storageKey     String               @unique @db.VarChar(191)
  checksumSha256 String               @db.Char(64)
  sizeBytes      Int
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  archive        LeaveDecisionArchive @relation(fields: [archiveId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model LeaveBalanceReturn {
  id                 String                        @id @db.Uuid
  leaveRequestId     String                        @db.Uuid
  revisionId         String                        @db.Uuid
  entitlementYear    Int
  restoredDays       Int
  reason             String                        @db.Text
  basisReference     String                        @db.VarChar(191)
  basisDate          DateTime                      @db.Date
  evidenceDocumentId String                        @db.Uuid
  recordedByUserId   String                        @db.Uuid
  recordedAt         DateTime                      @db.Timestamptz(3)
  sourceIp           String?                       @db.VarChar(64)
  idempotencyKey     String                        @unique @db.VarChar(140)
  payloadHash        String                        @db.Char(64)
  policyVersion      String                        @db.VarChar(100)
  snapshot           Json
  leaveRequest       LeaveRequest                  @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revision           LeaveRequestRevision          @relation(fields: [revisionId, leaveRequestId], references: [id, leaveRequestId], onDelete: Restrict, onUpdate: Restrict)
  evidenceDocument   LeaveDocument                 @relation(fields: [evidenceDocumentId, revisionId, leaveRequestId], references: [id, revisionId, leaveRequestId], onDelete: Restrict, onUpdate: Restrict)
  recorder           User                          @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operations         LeaveBalanceReturnOperation[]

  @@index([leaveRequestId, recordedAt])
}

model LeaveBalanceReturnOperation {
  returnId     String                 @db.Uuid
  operationId  String                 @unique @db.Uuid
  returnRecord LeaveBalanceReturn     @relation(fields: [returnId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operation    AnnualBalanceOperation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([returnId, operationId])
}

model LeaveDecisionEdition {
  id                   String               @id @default(uuid()) @db.Uuid
  archiveId            String               @db.Uuid
  version              Int
  placement            Json
  sourceVerified       Boolean              @default(true)
  rendererVersion      String               @default("form-stamp-v1") @db.VarChar(50)
  sourceChecksumSha256 String               @db.Char(64)
  createdByUserId      String               @db.Uuid
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  idempotencyKey       String               @unique @db.Uuid
  payloadHash          String               @db.Char(64)
  storageKey           String               @unique @db.VarChar(191)
  checksumSha256       String               @db.Char(64)
  sizeBytes            Int
  archive              LeaveDecisionArchive @relation(fields: [archiveId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator              User                 @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([archiveId, version])
}

model JointLeaveClaim {
  id String @id @default(uuid()) @db.Uuid
  employeeId String @db.Uuid
  employeeNameSnapshot String @db.VarChar(200)
  employeeNipSnapshot String @db.VarChar(32)
  policyId String @db.Uuid
  creditYear Int
  policySnapshot Json
  assignmentType String @db.VarChar(30)
  title String @db.VarChar(300)
  sprinNumber String? @db.VarChar(200)
  status String @default("SUBMITTED") @db.VarChar(20)
  submittedByUserId String @db.Uuid
  submittedAt DateTime @default(now()) @db.Timestamptz(3)
  idempotencyKey String @unique @db.Uuid
  payloadHash String @db.Char(64)
  evidenceKey String @unique @db.VarChar(191)
  evidenceChecksum String @db.Char(64)
  evidenceSize Int
  evidenceMime String @db.VarChar(50)
  reviewKey String? @unique @db.Uuid
  reviewHash String? @db.Char(64)
  reviewedByUserId String? @db.Uuid
  reviewedAt DateTime? @db.Timestamptz(3)
  reason String? @db.Text
  reviewSnapshot Json?
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  policy JointLeavePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  submitter User @relation("JointLeaveSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer User? @relation("JointLeaveReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dates JointLeaveClaimDate[]
  @@unique([id, employeeId, policyId])
  @@index([creditYear, status, submittedAt])
  @@index([employeeId, creditYear, submittedAt])
}
model JointLeaveClaimDate {
  id String @id @default(uuid()) @db.Uuid
  claimId String @db.Uuid
  employeeId String @db.Uuid
  policyId String @db.Uuid
  eventId String @db.Uuid
  eventDate DateTime @db.Date
  status String @default("PENDING") @db.VarChar(20)
  operationId String? @unique @db.Uuid
  claim JointLeaveClaim @relation(fields: [claimId, employeeId, policyId], references: [id, employeeId, policyId], onDelete: Restrict, onUpdate: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  event JointLeaveEvent @relation(fields: [eventId, policyId], references: [id, policyId], onDelete: Restrict, onUpdate: Restrict)
  operation AnnualBalanceOperation? @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([claimId, eventId])
  @@index([employeeId, eventDate, status])
}

model LeaveAuthorizedOfficialCorrection {
  id String @id @default(uuid()) @db.Uuid
  assignmentId String @db.Uuid
  actorUserId String @db.Uuid
  correctedAt DateTime @default(now()) @db.Timestamptz(3)
  reason String @db.VarChar(1000)
  sourceReference String @db.VarChar(500)
  fields String[]
  before Json
  after Json
  revision Int
  idempotencyKey String @unique @db.Uuid
  payloadHash String @db.Char(64)
  assignment LeaveAuthorizedOfficialAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([assignmentId, revision])
  @@index([assignmentId, correctedAt])
}

model CalendarOverlayVersion {
  id String @id @default(uuid()) @db.Uuid
  year Int
  version Int
  sourceReference String @db.VarChar(500)
  sourcePublishedOn DateTime @db.Date
